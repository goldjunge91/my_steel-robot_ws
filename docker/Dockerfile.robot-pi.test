# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
# Uses rosdep for ALL dependency management (no manual apt-get install lists)
# This Dockerfile creates a production-ready ROS2 robot image with:
# - Stage 1 (cacher): Fetch source code
# - Stage 2 (builder): Install dependencies and compile workspace
# - Stage 3 (final): Minimal runtime image

ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws

# ============================================================================
# Stage 1: Source Code Fetching (cacher)
# ============================================================================
FROM $FROM_IMAGE AS cacher

ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=feat_CI_CD
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal tools for source code fetching
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3-vcstool \
  git \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Create robot user
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

USER robot
WORKDIR $OVERLAY_WS

# Clone repository and import VCS dependencies
RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  vcs import src < "${VCS_FILE}"

# ============================================================================
# Stage 2: Build Stage (builder)
# ============================================================================
FROM $FROM_IMAGE AS builder

ARG OVERLAY_WS

ENV DEBIAN_FRONTEND=noninteractive

# Create robot user (same as cacher)
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

# Copy source code from cacher
COPY --from=cacher --chown=robot:robot $OVERLAY_WS $OVERLAY_WS

USER robot
WORKDIR $OVERLAY_WS

# Install ALL dependencies using rosdep (build + runtime)
# This is the CORRECT way - rosdep reads package.xml files
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  sudo apt-get update && \
  sudo rosdep init || true && \
  rosdep update --rosdistro $ROS_DISTRO && \
  rosdep install --from-paths src --ignore-src -y \
  --skip-keys "micro_ros_agent micro_ros_msgs"

# Build workspace with correct dependency order
# 1. Build micro_ros_msgs first (dependency of micro_ros_agent)
# 2. Build micro_ros_agent second
# 3. Build everything else
RUN source /opt/ros/$ROS_DISTRO/setup.bash && \
  echo "=== Building micro_ros_msgs ===" && \
  colcon build --packages-select micro_ros_msgs \
  --cmake-args -DCMAKE_BUILD_TYPE=Release && \
  echo "=== Building micro_ros_agent ===" && \
  colcon build --packages-select micro_ros_agent \
  --cmake-args -DCMAKE_BUILD_TYPE=Release && \
  echo "=== Building remaining packages ===" && \
  colcon build --packages-skip micro_ros_msgs micro_ros_agent \
  --cmake-args -DCMAKE_BUILD_TYPE=Release

# ============================================================================
# Stage 3: Runtime Image (final)
# ============================================================================
FROM $FROM_IMAGE AS final

ARG OVERLAY_WS

ENV DEBIAN_FRONTEND=noninteractive

# Create robot user (same as builder)
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

# Copy built workspace from builder
COPY --from=builder --chown=robot:robot $OVERLAY_WS $OVERLAY_WS

USER robot
WORKDIR $OVERLAY_WS

# Install ONLY runtime dependencies using rosdep
# --dependency-types=exec: Only install runtime dependencies (no build tools)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  sudo apt-get update && \
  sudo rosdep init || true && \
  rosdep update --rosdistro $ROS_DISTRO && \
  rosdep install --from-paths src --ignore-src -y \
  --dependency-types=exec \
  --skip-keys "micro_ros_agent micro_ros_msgs"

# Setup entrypoint
RUN echo '#!/bin/bash\n\
  set -e\n\
  source /opt/ros/$ROS_DISTRO/setup.bash\n\
  source $OVERLAY_WS/install/setup.bash\n\
  exec "$@"' > /entrypoint.sh && \
  sudo chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
