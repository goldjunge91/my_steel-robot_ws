# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
# This Dockerfile creates a production-ready ROS2 robot image with:
# - Stage 1 (cacher): Install dependencies and fetch source code
# - Stage 2 (builder): Compile the robot workspace 
# - Stage 3 (final): Minimal runtime image with compiled robot

ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws

# ============================================================================
# Stage 1: Dependency caching and source code preparation
# Purpose: Install all build dependencies and fetch source code
# This stage is heavily cached to speed up rebuilds
# ============================================================================
FROM $FROM_IMAGE AS cacher

RUN echo -e "\033[1;96m============================================================================\033[0m"
RUN echo -e "\033[1;96m🔧 STAGE 1: Dependency caching and source code preparation\033[0m"
RUN echo -e "\033[1;96m============================================================================\033[0m"
ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive \
  TERM=xterm-256color \
  FORCE_COLOR=1 \
  CLICOLOR_FORCE=1 \
  COLCON_LOG_LEVEL=20


# Configure apt for optimal Docker builds and update rosdep
# --mount=type=cache: Persist apt cache between builds for faster rebuilds
# rosdep update: Refresh ROS package database
# APT::Install-Recommends "false": Skip recommended packages to reduce image size
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rosdep update --rosdistro $ROS_DISTRO && \
  cat <<EOF > /etc/apt/apt.conf.d/docker-clean && apt-get update
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF


# Install minimal tools for source code fetching
# We'll use rosdep in builder stage to install actual dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get install -y --no-install-recommends \
  python3-rosdep \
  python3-vcstool \
  git \
  ca-certificates; \
  rm -rf /var/lib/apt/lists/*

# Create robot user for security best practices
# useradd -m: Create home directory
# usermod -aG sudo: Add to sudo group for package installation
# NOPASSWD: Allow sudo without password for convenience
# chown: Give robot user ownership of workspace
RUN echo -e "\033[1;96m Creating robot user \033[0m"
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/robot && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

RUN echo "[INFO] Switch to robot user and set workspace"
USER robot
WORKDIR $OVERLAY_WS
RUN echo "[INFO] end of line 109"


# Clone repository and import VCS dependencies
# git clone --depth 1: Shallow clone for faster download
# vcs import: Import all repositories defined in ros2.repos
RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  vcs import src < "${VCS_FILE}"

# Initialize rosdep and derive build and runtime dependencies
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && \
  rosdep update

# Derive build and runtime dependencies using rosdep
RUN bash -e <<'EOF'
declare -A types=(
  [exec]="--dependency-types=exec"
  [build]="")
for type in "${!types[@]}"; do
  rosdep install -y \
    --from-paths src \
    --ignore-src \
    --reinstall \
    --simulate \
    --rosdistro $ROS_DISTRO \
    ${types[$type]} \
    --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod" \
    | grep 'apt-get install' \
    | awk '{gsub(/'\''/,"",$4); print $4}' \
    | sort -u > /tmp/${type}_debs.txt
done
EOF


# ============================================================================
# Stage 2: Build environment - Compile the robot workspace
# Purpose: Install additional dependencies and build all ROS2 packages
# Inherits all dependencies and source code from cacher stage
# ============================================================================
FROM cacher AS builder

RUN echo -e "\033[1;93m============================================================================\033[0m"
RUN echo -e "\033[1;93m🏗️  STAGE 2: Build environment - Compile the robot workspace\033[0m"
RUN echo -e "\033[1;93m============================================================================\033[0m"

# Install BUILD dependencies from rosdep analysis (Option A: Official Pattern)
# Copy dependency list generated by rosdep in Stage 1
COPY --from=cacher /tmp/build_debs.txt /tmp/build_debs.txt

# Debug: Show what rosdep found
RUN echo "=== BUILD DEPENDENCIES FROM ROSDEP ===" && \
  if [ -s /tmp/build_debs.txt ]; then \
  echo "Found $(wc -l < /tmp/build_debs.txt) build dependencies:" && \
  head -20 /tmp/build_debs.txt && \
  echo "..."; \
  else \
  echo "WARNING: /tmp/build_debs.txt is EMPTY or missing!"; \
  fi

# Install build dependencies: rosdep packages + essential build tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  sudo apt-get update && \
  if [ -s /tmp/build_debs.txt ]; then \
  echo "Installing $(wc -l < /tmp/build_debs.txt) packages from rosdep..." && \
  cat /tmp/build_debs.txt | xargs sudo apt-get install -y --no-install-recommends; \
  else \
  echo "Skipping rosdep packages (file empty or missing)"; \
  fi && \
  echo "Installing essential build tools..." && \
  sudo apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  git \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-pip

# Build robot packages in dependency order
# Step-by-step approach ensures proper dependency resolution
# Use pre-built micro-ROS agent to avoid ARM64 emulation timeout issues

RUN echo -e "\033[1;32m=== Building complete workspace with automatic dependency resolution ===\033[0m"

# Build ALL packages in correct dependency order
# colcon automatically resolves dependencies and builds in the right order
# --merge-install: Single install directory for all packages
# --symlink-install: Faster rebuilds during development
# --continue-on-error: Don't stop on optional package failures
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --merge-install \
  --symlink-install \
  --continue-on-error \
  --event-handlers console_direct+"

# Build completed in steps above - no need for additional build.sh execution
RUN echo -e "\033[1;92m=== Build completed successfully ===\033[0m"

# ============================================================================
# Stage 3: Final runtime image - Production-ready robot container
# Purpose: Minimal image with only runtime dependencies and compiled robot
# Starts fresh from base image to exclude build tools and temporary files
# ============================================================================
FROM $FROM_IMAGE AS final

RUN echo -e "\033[1;92m============================================================================\033[0m"
RUN echo -e "\033[1;92m🚀 STAGE 3: Final runtime image - Production-ready robot container\033[0m"
RUN echo -e "\033[1;92m============================================================================\033[0m"

ENV DEBIAN_FRONTEND=noninteractive

# Install RUNTIME dependencies from rosdep analysis (Option A: Official Pattern)
# Copy runtime dependency list generated by rosdep in Stage 1
COPY --from=cacher /tmp/exec_debs.txt /tmp/exec_debs.txt

# Debug: Show what rosdep found for runtime
RUN echo "=== RUNTIME DEPENDENCIES FROM ROSDEP ===" && \
  if [ -s /tmp/exec_debs.txt ]; then \
  echo "Found $(wc -l < /tmp/exec_debs.txt) runtime dependencies:" && \
  head -20 /tmp/exec_debs.txt && \
  echo "..."; \
  else \
  echo "WARNING: /tmp/exec_debs.txt is EMPTY or missing!"; \
  fi

# Install runtime dependencies: rosdep packages + essential runtime tools
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update && \
  if [ -s /tmp/exec_debs.txt ]; then \
  echo "Installing $(wc -l < /tmp/exec_debs.txt) runtime packages from rosdep..." && \
  cat /tmp/exec_debs.txt | xargs apt-get install -y --no-install-recommends; \
  else \
  echo "Skipping rosdep runtime packages (file empty or missing)"; \
  fi && \
  echo "Installing essential runtime tools..." && \
  apt-get install -y --no-install-recommends \
  python3-colcon-common-extensions \
  python3-pip \
  v4l-utils \
  udev \
  usbutils \
  ca-certificates && \
  rm -rf /var/lib/apt/lists/*

# Create non-root user for security best practices
# Fresh user creation (no sudo needed in runtime)
RUN useradd -m -s /bin/bash robot

# Copy complete workspace from builder stage
# Includes: src/ (source code), build/ (build cache), install/ (compiled packages)
# This provides full ROS2 development capabilities in the runtime image
COPY --from=builder --chown=robot:robot /home/robot/workspace/my_steel-robot_ws /home/robot/workspace/my_steel-robot_ws

# Setup overlay install
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws
ENV OVERLAY_WS=$OVERLAY_WS
RUN sed --in-place --expression \
  '$isource "$OVERLAY_WS/install/setup.bash"' \
  /ros_entrypoint.sh

USER robot
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Set ROS2 environment variables for runtime
ENV ROS_DISTRO=humble \
  ROS_DOMAIN_ID=0 \
  RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Run launch file
CMD ["ros2", "launch", "robot_bringup", "bringup.launch.py"]