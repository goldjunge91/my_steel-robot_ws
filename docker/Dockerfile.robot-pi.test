# syntax=docker/dockerfile:1.6

ARG ROS_DISTRO=humble
ARG FROM_IMAGE=ros:${ROS_DISTRO}
ARG OVERLAY_WS=/opt/ros/overlay_ws
ARG RUN_WS=/home/robot/workspace

# multi-stage for caching
FROM $FROM_IMAGE AS cacher
ARG ROS_DISTRO
ARG OVERLAY_WS
ENV DEBIAN_FRONTEND=noninteractive

# overwrite defaults to persist minimal cache
RUN rosdep update --rosdistro "$ROS_DISTRO" && \
  cat <<'EOF' > /etc/apt/apt.conf.d/docker-clean && apt-get update
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF

# clone overlay source
WORKDIR $OVERLAY_WS
COPY . .
RUN mkdir -p src && \
  if [ -f src/ros2.repos ]; then \
  vcs import src < src/ros2.repos; \
  fi

# derive build/exec dependencies
RUN --mount=type=cache,target=/etc/apt/apt.conf.d \
  --mount=type=cache,target=/var/lib/apt/lists \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  bash -e <<'EOF'
set -eux
skip_keys="laser_filters xacro dynamixel_hardware_interface gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod"
declare -A types=(["exec"]="--dependency-types=exec" ["build"]="")
for type in "${!types[@]}"; do
  rosdep install -y \
    --from-paths src \
    --ignore-src \
    --rosdistro "$ROS_DISTRO" \
    --reinstall \
    --simulate \
    ${types[$type]} \
    --skip-keys "$skip_keys" \
  | python3 - "$type" <<'PY'
import shlex, sys

def tokenize(line: str) -> list[str]:
    lexer = shlex.shlex(line, posix=True)
    lexer.whitespace_split = True
    lexer.commenters = ''
    return list(lexer)

type_name = sys.argv[1] if len(sys.argv) > 1 else "deps"
pkgs = set()

for raw_line in sys.stdin:
    stripped = raw_line.strip()
    if "apt-get" not in stripped:
        continue
    tokens = tokenize(stripped)
    for idx, token in enumerate(tokens):
        if token.endswith("apt-get"):
            start = idx
            break
    else:
        continue

    try:
        install_idx = tokens.index("install", start)
    except ValueError:
        continue

    for pkg in tokens[install_idx + 1:]:
        if pkg.startswith("-") or "=" in pkg or pkg.endswith("\\"):
            continue
        pkgs.add(pkg)

target = f"/tmp/{type_name}_debs.txt"
with open(target, "w", encoding="utf-8") as fh:
    for pkg in sorted(pkgs):
        fh.write(pkg + "\n")
PY
done
for file in /tmp/*_debs.txt; do
  sed -i '/^$/d' "$file" || true
done
EOF

# multi-stage for building
FROM $FROM_IMAGE AS builder
ARG ROS_DISTRO
ARG OVERLAY_WS
ENV DEBIAN_FRONTEND=noninteractive

# install build dependencies
COPY --from=cacher /tmp/build_debs.txt /tmp/build_debs.txt
RUN --mount=type=cache,target=/etc/apt/apt.conf.d \
  --mount=type=cache,target=/var/lib/apt/lists \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  bash -e <<'EOF'
set -eux
apt-get update
apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  git \
  ros-${ROS_DISTRO}-control-msgs \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-vcstool
if [ -s /tmp/build_debs.txt ]; then
  xargs -r -a /tmp/build_debs.txt apt-get install -y --no-install-recommends
fi
rm -rf /var/lib/apt/lists/*
EOF

# build overlay source
WORKDIR $OVERLAY_WS
COPY --from=cacher $OVERLAY_WS/ .
RUN . /opt/ros/$ROS_DISTRO/setup.sh && \
  colcon build \
  --merge-install \
  --symlink-install \
  --cmake-args \
  -DCMAKE_BUILD_TYPE=RelWithDebInfo \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=On \
  -DCMAKE_CXX_FLAGS=-Wall\ -Wextra\ -Wpedantic

# multi-stage for running
FROM $FROM_IMAGE-ros-core AS runner
ARG OVERLAY_WS
ARG RUN_WS
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive

# install exec dependencies
COPY --from=cacher /tmp/exec_debs.txt /tmp/exec_debs.txt
RUN --mount=type=cache,target=/etc/apt/apt.conf.d \
  --mount=type=cache,target=/var/lib/apt/lists \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  bash -e <<'EOF'
set -eux
apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates \
  python3-rosdep \
  python3-vcstool \
  ros-${ROS_DISTRO}-control-msgs \
  v4l-utils \
  libv4l-0 \
  ros-${ROS_DISTRO}-ros2-control \
  ros-${ROS_DISTRO}-usb-cam \
  ros-${ROS_DISTRO}-foxglove-bridge \
  ros-${ROS_DISTRO}-robot-state-publisher \
  ros-${ROS_DISTRO}-joint-state-publisher \
  ros-${ROS_DISTRO}-controller-manager 
if [ -s /tmp/exec_debs.txt ]; then
  xargs -r -a /tmp/exec_debs.txt apt-get install -y --no-install-recommends
fi
rm -rf /var/lib/apt/lists/*
EOF

# setup overlay install
ENV OVERLAY_WS=$OVERLAY_WS
WORKDIR $OVERLAY_WS
COPY --from=builder $OVERLAY_WS/install $OVERLAY_WS/install
RUN sed --in-place --expression \
  '$isource "$OVERLAY_WS/install/setup.bash"' \
  /ros_entrypoint.sh

# switch to runtime workspace
WORKDIR $RUN_WS
ENV ROS_DISTRO=$ROS_DISTRO \
  ROS_DOMAIN_ID=0 \
  RMW_IMPLEMENTATION=rmw_fastrtps_cpp
RUN mkdir -p "$RUN_WS"

# run launch file / shell
CMD ["bash"]
