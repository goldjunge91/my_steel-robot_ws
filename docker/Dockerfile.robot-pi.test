# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
# This Dockerfile creates a production-ready ROS2 robot image with:
# - Stage 1 (cacher): Install dependencies and fetch source code
# - Stage 2 (builder): Compile the robot workspace 
# - Stage 3 (final): Minimal runtime image with compiled robot

ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws

# ============================================================================
# Stage 1: Dependency caching and source code preparation
# Purpose: Install all build dependencies and fetch source code
# This stage is heavily cached to speed up rebuilds
# ============================================================================
FROM $FROM_IMAGE AS cacher

RUN echo -e "\033[1;96m============================================================================\033[0m"
RUN echo -e "\033[1;96m🔧 STAGE 1: Dependency caching and source code preparation\033[0m"
RUN echo -e "\033[1;96m============================================================================\033[0m"
ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive \
  TERM=xterm-256color \
  FORCE_COLOR=1 \
  CLICOLOR_FORCE=1 \
  COLCON_LOG_LEVEL=20


# Configure apt for optimal Docker builds and update rosdep
# --mount=type=cache: Persist apt cache between builds for faster rebuilds
# rosdep update: Refresh ROS package database
# APT::Install-Recommends "false": Skip recommended packages to reduce image size
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rosdep update --rosdistro $ROS_DISTRO && \
  cat <<EOF > /etc/apt/apt.conf.d/docker-clean && apt-get update
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF


# Install build dependencies and proven ROS2 packages
# Build tools: build-essential, cmake, git for compilation
# ROS2 tools: colcon for building, rosdep for dependencies, vcstool for VCS
# System libs: SSL, YAML, spdlog for various robot components
# ROS2 packages: Manually tested packages that rosdep often misses
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get install -y --no-install-recommends \
  build-essential \
  libssl-dev \
  pkg-config \
  cmake \
  git \
  python3-pip \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-vcstool \
  ca-certificates \
  ros-humble-builtin-interfaces \
  ros-humble-hardware-interface \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-moveit-msgs \
  ros-humble-robot-localization \
  ros-humble-usb-cam \
  ros-humble-control-msgs \
  ros-humble-controller-interface \
  ros-humble-micro-ros-msgs \
  ros-humble-nav2-common \
  ros-humble-moveit-msgs \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  ros-humble-foxglove-bridge \
  ros-humble-robot-state-publisher \
  ros-humble-xacro \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c; \
  rm -rf /var/lib/apt/lists/*

# Create robot user for security best practices
# useradd -m: Create home directory
# usermod -aG sudo: Add to sudo group for package installation
# NOPASSWD: Allow sudo without password for convenience
# chown: Give robot user ownership of workspace
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

USER robot
WORKDIR $OVERLAY_WS


# Clone repository and import VCS dependencies
# git clone --depth 1: Shallow clone for faster download
# vcs import: Import all repositories defined in ros2.repos
RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  vcs import src < "${VCS_FILE}"

# Derive build and runtime dependencies using rosdep
RUN bash -e <<'EOF'
declare -A types=(
  [exec]="--dependency-types=exec"
  [build]="")
for type in "${!types[@]}"; do
  rosdep install -y \
    --from-paths src \
    --ignore-src \
    --reinstall \
    --simulate \
    --rosdistro $ROS_DISTRO \
    ${types[$type]} \
    --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod" \
    | grep 'apt-get install' \
    | awk '{gsub(/'\''/,"",$4); print $4}' \
    | sort -u > /tmp/${type}_debs.txt
done
EOF


# ============================================================================
# Stage 2: Build environment - Compile the robot workspace
# Purpose: Install additional dependencies and build all ROS2 packages
# Inherits all dependencies and source code from cacher stage
# ============================================================================
FROM cacher AS builder

RUN echo -e "\033[1;93m============================================================================\033[0m"
RUN echo -e "\033[1;93m🏗️  STAGE 2: Build environment - Compile the robot workspace\033[0m"
RUN echo -e "\033[1;93m============================================================================\033[0m"

# Install additional runtime dependencies discovered by rosdep
# This analyzes all package.xml files and installs missing dependencies
# Skip keys are packages that fail on ARM64 or are not needed for robot
# Cache mounts: Persist apt cache, rosdep cache, and package lists between builds
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  --mount=type=cache,target=/home/robot/.ros,sharing=locked \
  if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then sudo rosdep init; fi && \
  sudo rosdep update && \
  sudo apt-get update && \
  sudo rosdep install --from-paths src \
  --ignore-src \
  --rosdistro humble \
  --default-yes \
  --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod"

ARG COLCON_PARALLEL_WORKERS=2
ENV COLCON_PARALLEL_WORKERS=${COLCON_PARALLEL_WORKERS}

# Build robot packages in dependency order
# Step-by-step approach ensures proper dependency resolution
#   --cmake-args -DCMAKE_BUILD_TYPE=Release \
#   --continue-on-error

RUN echo -e "\033[1;32m=== Start step by step build ===\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  echo -e '\033[1;34m=== Building micro_ros_agent ===\033[0m' && \
  colcon build --packages-select micro_ros_agent --merge-install"


# Step 1: Build micro_ros_agent (critical for Pico communication)
# source setup.bash: Load ROS2 environment
# --parallel-workers 1: Single thread to avoid race conditions in micro-ROS
# --packages-up-to: Build package and all its dependencies
# --merge-install: Combine install spaces for smaller image
RUN bash -c "source /opt/ros/humble/setup.bash && \
  echo '=== Listing all packages ===' && \
  colcon list --base-paths src && \
  echo '=== Building micro_ros_agent ===' && \
  colcon build \
  --parallel-workers 1 \
  --packages-up-to micro_ros_agent \
  --event-handlers console_direct+ \
  --merge-install"

# --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_VERBOSE_MAKEFILE=ON \

# Step 2: Build open_manipulator_x_description (robot arm URDF)
# --packages-select: Build only this specific package
# --continue-on-error: Don't fail build if this optional package fails
RUN echo -e "\033[1;33m[STEP 2] Build open_manipulator_x_description\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select \
  open_manipulator_x_description \
  --merge-install \
  --continue-on-error"

# RUN . /opt/ros/humble/setup.sh && \
#   colcon build \
#   --cmake-args -DCMAKE_BUILD_TYPE=Release \
#   --packages-select open_manipulator_x_description \
#   --merge-install \
#   --continue-on-error
# #

# Step 3: Build core robot packages (URDF + hardware interface)
# robot_description: Robot URDF model and meshes
# robot_hardware_interfaces: ros2_control hardware plugin for Pico
# --symlink-install: Create symlinks for faster development iteration
RUN echo -e "\033[1;36m[STEP 3] Build robot_description robot_hardware_interfaces packages\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_description robot_hardware_interfaces \
  --merge-install \
  --symlink-install \
  --continue-on-error"

# Step 4: Build robot_utils (helper functions and tools)
RUN echo -e "\033[1;35m[STEP 4] Build robot_utils\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_utils \
  --merge-install \
  --symlink-install \
  --continue-on-error"

# Step 5: Build robot_controller (ros2_control configuration)
# Contains controller configs for mecanum drive and manipulator
RUN echo -e "\033[1;31m[STEP 5] Build robot_controller\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select \
  robot_controller \
  --merge-install \
  --symlink-install"

# Step 6: Build robot_bringup (main launch package)
# Contains launch files that start the complete robot system
RUN echo -e "\033[1;32m[STEP 6] Build robot_bringup\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_bringup \
  --merge-install \
  --symlink-install"

# Step 7: Build umbrella package (meta-package for complete robot)
# Installs all configurations and makes robot command available
RUN echo -e "\033[1;92m[STEP 7] Build robot umbrella package\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot \
  --merge-install \
  --symlink-install"

# RUN . /opt/ros/humble/setup.sh && \
#   chmod +x build.sh && \
#   # chmod +x setup.sh && \
#   # ./setup.sh && \
#   ./build.sh

# ============================================================================
# Stage 3: Final runtime image - Production-ready robot container
# Purpose: Minimal image with only runtime dependencies and compiled robot
# Starts fresh from base image to exclude build tools and temporary files
# ============================================================================
FROM $FROM_IMAGE AS final

RUN echo -e "\033[1;92m============================================================================\033[0m"
RUN echo -e "\033[1;92m🚀 STAGE 3: Final runtime image - Production-ready robot container\033[0m"
RUN echo -e "\033[1;92m============================================================================\033[0m"

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime system libraries (no ROS packages - they come from workspace)
# python3-colcon: For potential runtime rebuilds
# v4l-utils: Video4Linux camera support
# libasio/libyaml/libspdlog: System libraries for robot components
# udev/usbutils: USB device management for Pico and camera
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3-colcon-common-extensions \
  python3-pip \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  udev \
  usbutils \
  && rm -rf /var/lib/apt/lists/*

# Create non-root user for security best practices
# Fresh user creation (no sudo needed in runtime)
RUN useradd -m -s /bin/bash robot

# Copy complete workspace from builder stage
# Includes: src/ (source code), build/ (build cache), install/ (compiled packages)
# This provides full ROS2 development capabilities in the runtime image
COPY --from=builder --chown=robot:robot /home/robot/workspace/my_steel-robot_ws /home/robot/workspace/my_steel-robot_ws

USER robot
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Set ROS2 environment variables for runtime
ENV ROS_DISTRO=humble \
  ROS_DOMAIN_ID=0 \
  RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Default command sources both ROS2 base and robot workspace
# This makes all robot packages available: micro_ros_agent, robot_bringup, etc.
CMD ["bash","-lc","source /opt/ros/humble/setup.bash && source /home/robot/workspace/my_steel-robot_ws/install/setup.bash && bash"]