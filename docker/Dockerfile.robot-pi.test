# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws
# Stage 1: Dependency caching and resolution
FROM $FROM_IMAGE AS cacher
ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive
# Optimize apt caching and disable recommends for smaller image
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rosdep update --rosdistro $ROS_DISTRO && \
  cat <<EOF > /etc/apt/apt.conf.d/docker-clean && apt-get update
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get install -y --no-install-recommends \
  build-essential \
  libssl-dev \
  pkg-config \
  cmake \
  git \
  python3-pip \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-vcstool \
  ca-certificates \
  ros-humble-builtin-interfaces \
  ros-humble-hardware-interface \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-moveit-msgs \
  ros-humble-robot-localization \
  ros-humble-usb-cam \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  ros-humble-foxglove-bridge \
  ros-humble-robot-state-publisher \
  ros-humble-xacro \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c; \
  rm -rf /var/lib/apt/lists/*

# Create robot user for security best practices
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

USER robot
WORKDIR $OVERLAY_WS


# Clone repository and import VCS dependencies
RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  vcs import src < "${VCS_FILE}"

# Derive build and runtime dependencies using rosdep
RUN bash -e <<'EOF'
declare -A types=(
  [exec]="--dependency-types=exec"
  [build]="")
for type in "${!types[@]}"; do
  rosdep install -y \
    --from-paths src \
    --ignore-src \
    --reinstall \
    --simulate \
    --rosdistro $ROS_DISTRO \
    ${types[$type]} \
    --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod" \
    | grep 'apt-get install' \
    | awk '{gsub(/'\''/,"",$4); print $4}' \
    | sort -u > /tmp/${type}_debs.txt
done
EOF


# Stage 2: Build environment with dependencies  
FROM cacher AS builder

# Install additional dependencies with rosdep
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then sudo rosdep init; fi && \
  sudo rosdep update && \
  sudo apt-get update && \
  sudo rosdep install --from-paths src \
  --ignore-src \
  --rosdistro humble \
  --default-yes \
  --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod"

ARG COLCON_PARALLEL_WORKERS=2
ENV COLCON_PARALLEL_WORKERS=${COLCON_PARALLEL_WORKERS}

RUN echo "Start step by step build"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  echo '=== Listing all packages ===' && \
  colcon list --base-paths src && \
  echo '=== Building micro_ros_agent ===' && \
  colcon build \
  --parallel-workers 1 \
  --packages-up-to micro_ros_agent \
  --event-handlers console_direct+ \
  --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_VERBOSE_MAKEFILE=ON \
  --merge-install"


# Step 3: Build open_manipulator_x packages (dependency for robot_description)
RUN echo "[STEP 3] Build open_manipulator_x_description"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select \
  open_manipulator_x_description \
  --merge-install \
  --continue-on-error"

# RUN . /opt/ros/humble/setup.sh && \
#   colcon build \
#   --cmake-args -DCMAKE_BUILD_TYPE=Release \
#   --packages-select open_manipulator_x_description \
#   --merge-install \
#   --continue-on-error
# #

RUN echo "[STEP 4] Build robot_description robot_hardware_interfaces packages"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_description robot_hardware_interfaces \
  --merge-install \
  --symlink-install \
  --continue-on-error"

# Step 5: Build robot_utils 
RUN echo "[STEP 5] Build robot_utils"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_utils \
  --merge-install \
  --symlink-install \
  --continue-on-error"

# Step 6: Build controller and localization packages
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select \
  robot_controller \
  --merge-install \
  --symlink-install"

# Step 7: Build bringup package (depends on everything else)
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot_bringup \
  --merge-install \
  --symlink-install"

# Step 8: Build umbrella package to install configs/launch files
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers ${COLCON_PARALLEL_WORKERS} \
  --packages-select robot \
  --merge-install \
  --symlink-install"

# # Step 3: Build open_manipulator_x packages (dependency for robot_description)
# RUN . /opt/ros/humble/setup.sh && \
#   colcon build \
#   --cmake-args -DCMAKE_BUILD_TYPE=Release \
#   --packages-select open_manipulator_x \
#   --merge-install \
#   --symlink-install \
#   --continue-on-error
# RUN . /opt/ros/humble/setup.sh && \
#   chmod +x build.sh && \
#   # chmod +x setup.sh && \
#   # ./setup.sh && \
#   ./build.sh

# --- Stage: final (runtime image) ---------------
FROM ros:humble-ros-base AS final

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies (all ros-humble packages needed at runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-controller-manager \
  ros-humble-robot-state-publisher \
  ros-humble-joint-state-publisher \
  ros-humble-foxglove-bridge \
  ros-humble-xacro \
  ros-humble-usb-cam \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy complete workspace (src, build, install) for full ROS2 development
COPY --from=builder /home/robot/workspace/my_steel-robot_ws /home/robot/workspace/my_steel-robot_ws

# set user + workdir (if you prefer a non-root runtime)
RUN useradd -m -s /bin/bash robot && \
  chown -R robot:robot /home/robot

USER robot
WORKDIR /home/robot/workspace/my_steel-robot_ws

ENV ROS_DISTRO=humble \
  ROS_DOMAIN_ID=0 \
  RMW_IMPLEMENTATION=rmw_fastrtps_cpp

CMD ["bash","-lc","source /opt/ros/humble/setup.bash && source /home/robot/workspace/my_steel-robot_ws/install/setup.bash && bash"]

# ENV ROS_DISTRO=humble \
#   ROS_DOMAIN_ID=0 \
#   RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# CMD ["bash","-lc","source /opt/ros/humble/setup.bash && source /home/robot/workspace/my_steel-robot_ws/install/setup.bash && bash"]
