# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
# This Dockerfile creates a production-ready ROS2 robot image with:
# - Stage 1 (cacher): Install dependencies and fetch source code
# - Stage 2 (builder): Compile the robot workspace 
# - Stage 3 (final): Minimal runtime image with compiled robot

ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws

# ============================================================================
# Stage 1: Dependency caching and source code preparation
# Purpose: Install all build dependencies and fetch source code
# This stage is heavily cached to speed up rebuilds
# ============================================================================
FROM $FROM_IMAGE AS cacher

RUN echo -e "\033[1;96m============================================================================\033[0m"
RUN echo -e "\033[1;96m🔧 STAGE 1: Dependency caching and source code preparation\033[0m"
RUN echo -e "\033[1;96m============================================================================\033[0m"
ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive \
  TERM=xterm-256color \
  FORCE_COLOR=1 \
  CLICOLOR_FORCE=1 \
  COLCON_LOG_LEVEL=20

# Install build dependencies
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-pip \
  build-essential \
  cmake \
  git \
  ros-humble-builtin-interfaces \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/*

# Configure apt for optimal Docker builds and update rosdep
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rosdep update --rosdistro $ROS_DISTRO && \
  cat <<EOF > /etc/apt/apt.conf.d/docker-clean && apt-get update
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF

# Install additional build dependencies and proven ROS2 packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get install -y --no-install-recommends \
  build-essential \
  libssl-dev \
  pkg-config \
  cmake \
  git \
  python3-pip \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-vcstool \
  ca-certificates \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  ros-humble-builtin-interfaces \
  ros-humble-hardware-interface \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-moveit-msgs \
  ros-humble-robot-localization \
  ros-humble-usb-cam \
  ros-humble-control-msgs \
  ros-humble-controller-interface \
  ros-humble-micro-ros-msgs \
  ros-humble-nav2-common \
  ros-humble-moveit-ros-planning \
  ros-humble-foxglove-bridge \
  ros-humble-moveit \
  ros-humble-moveit-core \
  ros-humble-moveit-ros-planning \
  ros-humble-moveit-ros-planning-interface \
  ros-humble-moveit-planners-ompl \
  ros-humble-moveit-servo \
  ros-humble-moveit-simple-controller-manager \
  ros-humble-robot-state-publisher \
  ros-humble-xacro \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c; \
  rm -rf /var/lib/apt/lists/*

# Create robot user for security best practices
RUN useradd -m -s /bin/bash robot && \
  usermod -aG sudo robot && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  echo "robot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/robot && \
  mkdir -p $OVERLAY_WS && \
  chown -R robot:robot /home/robot

USER robot
WORKDIR $OVERLAY_WS

# Clone repository and import VCS dependencies
RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  vcs import src < "${VCS_FILE}"

# Initialize rosdep and derive build and runtime dependencies
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && \
  rosdep update

# Install additional runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  sudo apt-get update && \
  sudo rosdep install --from-paths src \
  --ignore-src \
  --rosdistro humble \
  --default-yes \
  --skip-keys "laser_filters gazebo_ros gazebo_ros2_control ros_gz_sim ros_gz_bridge python3-libgpiod"

# ============================================================================
# Stage 2: Build environment - Compile the robot workspace
# ============================================================================
FROM cacher AS builder

RUN echo -e "\033[1;93m============================================================================\033[0m"
RUN echo -e "\033[1;93m🏗️  STAGE 2: Build environment - Compile the robot workspace\033[0m"
RUN echo -e "\033[1;93m============================================================================\033[0m"

# Build robot packages step by step
RUN echo -e "\033[1;32m=== Building micro-ROS agent ===\033[0m"
RUN if [ -d "src/micro-ROS-Agent" ]; then \
  bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --parallel-workers 1 \
  --packages-select micro_ros_agent \
  --merge-install"; \
  fi

RUN echo -e "\033[1;33m[STEP 1] Build open_manipulator_x_description\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select open_manipulator_x_description \
  --merge-install \
  --continue-on-error"

RUN echo -e "\033[1;36m[STEP 2] Build robot core packages\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_description robot_hardware_interfaces \
  --merge-install \
  --symlink-install \
  --continue-on-error"

RUN echo -e "\033[1;35m[STEP 3] Build robot_utils\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_utils \
  --merge-install \
  --symlink-install \
  --continue-on-error"

RUN echo -e "\033[1;31m[STEP 4] Build robot_controller\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_controller \
  --merge-install \
  --symlink-install"

RUN echo -e "\033[1;32m[STEP 5] Build robot_bringup\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_bringup \
  --merge-install \
  --symlink-install"

RUN echo -e "\033[1;92m[STEP 6] Build robot umbrella package\033[0m"
RUN bash -c "source /opt/ros/humble/setup.bash && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot \
  --merge-install \
  --symlink-install \
  --continue-on-error"

# ============================================================================
# Stage 3: Final runtime image - Production-ready robot container
# ============================================================================
FROM $FROM_IMAGE AS final

RUN echo -e "\033[1;92m============================================================================\033[0m"
RUN echo -e "\033[1;92m🚀 STAGE 3: Final runtime image - Production-ready robot container\033[0m"
RUN echo -e "\033[1;92m============================================================================\033[0m"

ENV DEBIAN_FRONTEND=noninteractive 
# Install runtime dependencies and system tools
RUN apt-get update && \
  apt-get upgrade -y && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  python3-ament-package \
  ros-humble-usb-cam \
  v4l-utils \
  libv4l-0 \
  ros-humble-foxglove-bridge \
  ros-humble-robot-state-publisher \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-ros2-control \
  ros-humble-micro-ros-msgs \
  ros-humble-moveit-msgs \
  ros-humble-moveit-ros-planning \
  ros-humble-moveit \
  udev \
  usbutils \
  curl \
  gnupg \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/*

# Install Tailscale
RUN curl -fsSL https://tailscale.com/install.sh | sh

# Create non-root robot user with necessary group memberships
RUN useradd -m -s /bin/bash robot && \
  usermod -aG dialout,video robot

# Create non-root user for security best practices
RUN useradd -m -s /bin/bash robot

# Copy complete workspace from builder stage
COPY --from=builder --chown=robot:robot /home/robot/workspace/my_steel-robot_ws /home/robot/workspace/my_steel-robot_ws

USER robot
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Create Tailscale startup script (runs only when credentials are provided)
RUN mkdir -p /usr/local/bin && \
  cat <<'EOF' >/usr/local/bin/tailscale-start.sh
#!/bin/bash
set -euo pipefail

# Skip when no auth key or when running as non-root (tailscale needs CAP_SYS_ADMIN)
if [ -z "${TAILSCALE_AUTHKEY:-}" ]; then
  echo "[tailscale] No auth key provided, skipping Tailscale setup"
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "[tailscale] Not running as root, skipping Tailscale setup"
  exit 0
fi

echo "[tailscale] Starting tailscaled daemon..."
mkdir -p /var/lib/tailscale
tailscaled --state=/var/lib/tailscale/tailscaled.state >/var/log/robot/tailscaled.log 2>&1 &

# Give the daemon a moment to come up
for _ in $(seq 1 10); do
  if tailscale status >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

echo "[tailscale] Bringing interface up..."
tailscale up \
  --authkey="${TAILSCALE_AUTHKEY}" \
  --hostname="${TAILSCALE_HOSTNAME:-robot-xl}" \
  ${TAILSCALE_SUBNET_ROUTES:+--advertise-routes="${TAILSCALE_SUBNET_ROUTES}"} \
  --accept-routes \
  --reset

echo "[tailscale] Connected"
EOF

RUN chmod +x /usr/local/bin/tailscale-start.sh

# Create entrypoint script with ROS environment setup and graceful shutdown
RUN cat <<'EOF' >/usr/local/bin/entrypoint.sh
#!/bin/bash
set -euo pipefail

shutdown_handler() {
  echo "[entrypoint] Received termination signal, stopping child process..."
  if [ -n "${CHILD_PID:-}" ] && kill -0 "${CHILD_PID}" 2>/dev/null; then
    kill -TERM "${CHILD_PID}" 2>/dev/null || true
    wait "${CHILD_PID}" 2>/dev/null || true
  fi
  echo "[entrypoint] Shutdown complete"
  exit 0
}

trap shutdown_handler SIGINT SIGTERM

echo "[entrypoint] Sourcing ROS environments"
source /opt/ros/humble/setup.bash
if [ -f /home/robot/workspace/my_steel-robot_ws/install/setup.bash ]; then
  source /home/robot/workspace/my_steel-robot_ws/install/setup.bash
fi

# Start Tailscale when possible (runs as background task)
/usr/local/bin/tailscale-start.sh || true

echo "[entrypoint] Executing command: $*"
exec "$@"
EOF

# Make entrypoint executable
RUN chmod +x /usr/local/bin/entrypoint.sh

# Set working directory (consistent with compose.yaml)
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Create log directory
RUN mkdir -p /var/log/robot && \
  chown -R robot:robot /var/log/robot

# Switch to non-root user for runtime
USER robot

# Set environment variables
ENV ROS_DISTRO=humble
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOG_DIR=/var/log/robot
ENV ROBOT_MODEL_NAME=robot_xl

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Run launch file
CMD ["ros2", "launch", "robot_bringup", "bringup.launch.py"]
