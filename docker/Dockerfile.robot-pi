# Multi-stage build optimized for ROS2 Humble Robot Pi deployment
# This Dockerfile creates a production-ready ROS2 robot image with:
# - Stage 1 (cacher): Install dependencies and fetch source code
# - Stage 2 (builder): Compile the robot workspace 
# - Stage 3 (final): Minimal runtime image with compiled robot

ARG FROM_IMAGE=ros:humble-ros-base
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws

# ============================================================================
# Stage 1: Dependency caching and source code preparation
# Purpose: Install all build dependencies and fetch source code
# This stage is heavily cached to speed up rebuilds
# ============================================================================
FROM $FROM_IMAGE AS cacher

RUN echo -e "\033[1;96m============================================================================\033[0m"
RUN echo -e "\033[1;96m🔧 STAGE 1: Dependency caching and source code preparation\033[0m"
RUN echo -e "\033[1;96m============================================================================\033[0m"
ARG OVERLAY_WS
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

ENV DEBIAN_FRONTEND=noninteractive \
  TERM=xterm-256color \
  FORCE_COLOR=1 \
  CLICOLOR_FORCE=1 \
  COLCON_LOG_LEVEL=20

# Install build dependencies
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  python3-colcon-common-extensions \
  python3-colcon-mixin \
  python3-rosdep \
  python3-pip \
  build-essential \
  cmake \
  git \
  ros-humble-builtin-interfaces \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/*

# Create workspace (consistent with compose.yaml)
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Clone source code (consistent with .test approach)
ARG REPO_URL=https://github.com/goldjunge91/my_steel-robot_ws.git
ARG REPO_BRANCH=humble
ARG VCS_FILE=src/ros2.repos

RUN git clone --branch "${REPO_BRANCH}" --depth 1 "${REPO_URL}" . && \
  python3 -m pip install vcstool && \
  vcs import src < "${VCS_FILE}"

ARG COLCON_MIXINS=release
ARG COLCON_PACKAGES_SELECT=""
ARG COLCON_PACKAGES_UP_TO=""
ARG COLCON_BUILD_EXTRA_ARGS=""
ENV COLCON_MIXINS=${COLCON_MIXINS} \
  COLCON_PACKAGES_SELECT=${COLCON_PACKAGES_SELECT} \
  COLCON_PACKAGES_UP_TO=${COLCON_PACKAGES_UP_TO} \
  COLCON_BUILD_EXTRA_ARGS=${COLCON_BUILD_EXTRA_ARGS}

# Initialize rosdep if not already done
RUN rosdep update || true

# Install your proven manual dependencies (from .test file)
RUN apt-get update && apt-get install -y \
  libssl-dev \
  pkg-config \
  python3-ament-package \
  ros-humble-builtin-interfaces \
  ros-humble-hardware-interface \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-moveit-msgs \
  ros-humble-moveit-ros-planning \
  ros-humble-moveit \
  ros-humble-micro-ros-msgs \
  ros-humble-robot-localization \
  ros-humble-usb-cam \
  v4l-utils \
  libv4l-0 \
  libasio-dev \
  libtinyxml2-dev \
  libyaml-cpp-dev \
  libspdlog-dev \
  ros-humble-foxglove-bridge \
  ros-humble-robot-state-publisher \
  ros-humble-xacro \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-rosidl-runtime-c \
  ros-humble-rosidl-generator-c \
  && rm -rf /var/lib/apt/lists/* /tmp/*

# Skip rosdeps that fail to resolve for arm64 cross builds
RUN apt-get update && \
  rosdep install --from-paths src \
  --ignore-src \
  --rosdistro humble \
  --skip-keys "dynamixel_hardware_interface laser_filters gz_ros2_control ros_gz_sim ros_gz_bridge" \
  -y && \
  rm -rf /var/lib/apt/lists/* /tmp/*

# Build packages in multiple steps to handle dependencies correctly
# Note: micro_ros_agent will be built from source in src/micro-ROS-Agent

RUN . /opt/ros/humble/setup.sh && \
  echo "=== Listing all packages ===" && \
  colcon list --base-paths src && \
  echo "=== Building micro_ros_agent ===" && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --merge-install

# Step 2: Build components (base dependency)
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select components_description \
  --merge-install \
  --continue-on-error

# Step 3: Build open_manipulator_x packages (dependency for robot_description)
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select \
  open_manipulator_x_description \
  --merge-install \
  --continue-on-error

# Step 4: Build robot core packages
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select \
  robot_description \
  robot_hardware_interfaces \
  --merge-install

# Step 5: Build robot_utils (dependency for robot_controller)
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_utils \
  --merge-install \
  --continue-on-error

# Step 6: Build controller and localization packages
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select \
  robot_controller \
  --merge-install

# Step 7: Build bringup package (depends on everything else)
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot_bringup \
  --merge-install

# Step 8: Build umbrella package to install configs/launch files
RUN . /opt/ros/humble/setup.sh && \
  colcon build \
  --cmake-args -DCMAKE_BUILD_TYPE=Release \
  --packages-select robot \
  --merge-install

# ============================================================================
# Stage 2: Runtime - Production image
# ============================================================================
# FROM ros:humble-ros-core
FROM ros:humble-ros-base 
# Install runtime dependencies and system tools
RUN apt-get update && \
  apt-get upgrade -y && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  python3-ament-package \
  ros-humble-usb-cam \
  v4l-utils \
  libv4l-0 \
  ros-humble-foxglove-bridge \
  ros-humble-robot-state-publisher \
  ros-humble-joint-state-publisher \
  ros-humble-controller-manager \
  ros-humble-ros2-control \
  ros-humble-micro-ros-msgs \
  ros-humble-moveit-msgs \
  ros-humble-moveit-ros-planning \
  ros-humble-moveit \
  udev \
  usbutils \
  curl \
  gnupg \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/*

# Install Tailscale
RUN curl -fsSL https://tailscale.com/install.sh | sh

# Create non-root robot user with necessary group memberships
RUN useradd -m -s /bin/bash robot && \
  usermod -aG dialout,video robot

# Setup overlay install
ARG OVERLAY_WS=/home/robot/workspace/my_steel-robot_ws
ENV OVERLAY_WS=$OVERLAY_WS
COPY --from=cacher $OVERLAY_WS/install $OVERLAY_WS/install
COPY --from=cacher /home/robot/workspace/my_steel-robot_ws/build /home/robot/workspace/my_steel-robot_ws/build
COPY --from=cacher /home/robot/workspace/my_steel-robot_ws/src /home/robot/workspace/my_steel-robot_ws/src
RUN sed --in-place --expression \
  '$isource "$OVERLAY_WS/install/setup.bash"' \
  /ros_entrypoint.sh

# Create Tailscale startup script (runs only when credentials are provided)
RUN mkdir -p /usr/local/bin && \
  cat <<'EOF' >/usr/local/bin/tailscale-start.sh
#!/bin/bash
set -euo pipefail

# Skip when no auth key or when running as non-root (tailscale needs CAP_SYS_ADMIN)
if [ -z "${TAILSCALE_AUTHKEY:-}" ]; then
  echo "[tailscale] No auth key provided, skipping Tailscale setup"
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "[tailscale] Not running as root, skipping Tailscale setup"
  exit 0
fi

echo "[tailscale] Starting tailscaled daemon..."
mkdir -p /var/lib/tailscale
tailscaled --state=/var/lib/tailscale/tailscaled.state >/var/log/robot/tailscaled.log 2>&1 &

# Give the daemon a moment to come up
for _ in $(seq 1 10); do
  if tailscale status >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

echo "[tailscale] Bringing interface up..."
tailscale up \
  --authkey="${TAILSCALE_AUTHKEY}" \
  --hostname="${TAILSCALE_HOSTNAME:-robot-xl}" \
  ${TAILSCALE_SUBNET_ROUTES:+--advertise-routes="${TAILSCALE_SUBNET_ROUTES}"} \
  --accept-routes \
  --reset

echo "[tailscale] Connected"
EOF

RUN chmod +x /usr/local/bin/tailscale-start.sh

# Create entrypoint script with ROS environment setup and graceful shutdown
RUN cat <<'EOF' >/usr/local/bin/entrypoint.sh
#!/bin/bash
set -euo pipefail

shutdown_handler() {
  echo "[entrypoint] Received termination signal, stopping child process..."
  if [ -n "${CHILD_PID:-}" ] && kill -0 "${CHILD_PID}" 2>/dev/null; then
    kill -TERM "${CHILD_PID}" 2>/dev/null || true
    wait "${CHILD_PID}" 2>/dev/null || true
  fi
  echo "[entrypoint] Shutdown complete"
  exit 0
}

trap shutdown_handler SIGINT SIGTERM

echo "[entrypoint] Sourcing ROS environments"
source /opt/ros/humble/setup.bash
if [ -f /home/robot/workspace/my_steel-robot_ws/install/setup.bash ]; then
  source /home/robot/workspace/my_steel-robot_ws/install/setup.bash
fi

# Start Tailscale when possible (runs as background task)
/usr/local/bin/tailscale-start.sh || true

echo "[entrypoint] Executing command: $*"
exec "$@"
EOF

# Make entrypoint executable
RUN chmod +x /usr/local/bin/entrypoint.sh

# Set working directory (consistent with compose.yaml)
WORKDIR /home/robot/workspace/my_steel-robot_ws

# Create log directory
RUN mkdir -p /var/log/robot && \
  chown -R robot:robot /var/log/robot

# Switch to non-root user for runtime
USER robot

# Set environment variables
ENV ROS_DISTRO=humble
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOG_DIR=/var/log/robot
ENV ROBOT_MODEL_NAME=robot_xl

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Run launch file
CMD ["ros2", "launch", "robot_bringup", "bringup.launch.py"]
