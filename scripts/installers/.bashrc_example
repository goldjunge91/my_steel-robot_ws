# --- fzf ROS 2 Funktionen (Interaktiv) ---
# Interactive package selector
ros2_pkg_fzf() {
  local pkg=$(ros2 pkg list | fzf --prompt="Select package: " --preview='ros2 pkg xml {}')
  if [ -n "$pkg" ]; then
    echo "$pkg"
  fi
}

# Interaktives Topic Echo
ros2_echo_fzf() {
  local topic=$(ros2 topic list | fzf --prompt="Select topic to echo: " --preview='ros2 topic info {} && echo "---" && ros2 topic hz {} --once')
  if [ -n "$topic" ]; then
    echo "Echoing $topic..."
    ros2 topic echo "$topic"
  fi
}

# Interactive topic info
ros2_topic_fzf() {
  local topic=$(ros2 topic list | fzf --prompt="Select topic: " --preview='ros2 topic info {} --verbose')
  if [ -n "$topic" ]; then
    ros2 topic info "$topic" --verbose
  fi
}

# Interactive node info
ros2_node_fzf() {
  local node=$(ros2 node list | fzf --prompt="Select node: " --preview='ros2 node info {}')
  if [ -n "$node" ]; then
    ros2 node info "$node"
  fi
}

# Interactive package build
ros2_build_fzf() {
  local pkg=$(ros2 pkg list | fzf --prompt="Select package to build: " --preview='ros2 pkg xml {}')
  if [ -n "$pkg" ]; then
    echo "Building $pkg..."
    colcon build --packages-select "$pkg"
  fi
}
rbuild() { # Interaktives Build
  local pkg=$(ros2 pkg list | fzf --prompt="Build package: ")
  [ -n "$pkg" ] && colcon build --symlink-install --packages-select "$pkg"
}

# --- fzf ROS 2 Interaktiv ---
alias rte='ros2_echo_fzf'
alias rtl='ros2_topic_fzf'
alias rnl='ros2_node_fzf'
alias rpkg='ros2_pkg_fzf'
alias rbuild='ros2_build_fzf'

# --- Git shortcuts ---
alias gs='git status'
