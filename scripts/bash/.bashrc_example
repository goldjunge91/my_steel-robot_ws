# --- Custom Functions ---

# Quick cd + ls
cd() {
  builtin cd "$@" && ls -F --color=auto
}

# Create and enter directory
mkcd() {
  mkdir -p "$1" && cd "$1" || exit
}

# Search history with fzf
hist() {
  eval $(history | fzf --tac --no-sort | sed 's/^[ 0-9]*[ ]*//')
}

# Find and edit file with fzf
vf() {
  local file=$(fzf --preview 'head -100 {}')
  if [ -n "$file" ]; then
    "${EDITOR:-code}" "$file"
  fi
}

