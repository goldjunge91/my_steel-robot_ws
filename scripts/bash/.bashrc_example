# Interactive git branch selector with fzf
git_branch_fzf() {
  local branch=$(git branch -a | sed 's/^[* ]*//' | fzf --prompt="Select branch: " --preview='git log --oneline --graph --date=short --pretty="format:%C(auto)%cd %h%d %s" {} | head -50')
  if [ -n "$branch" ]; then
    git checkout "$branch"
  fi
}
alias gbr='git_branch_fzf'

