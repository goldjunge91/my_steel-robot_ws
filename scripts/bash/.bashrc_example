# --- Custom compact prompt (time without seconds, no hostname) ---
# Shows: HH:MM username cwd [git-branch] →
set_compact_prompt() {
  local gitbranch=""
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    gitbranch=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$PWD" rev-parse --short HEAD 2>/dev/null || true)
  fi
  if [ -n "$gitbranch" ] && [ "$gitbranch" != "HEAD" ]; then
    gitbranch=" \[\e[35m\][${gitbranch}]\[\e[0m\]"
  else
    gitbranch=""
  fi

  # Colors: time=yellow, user=cyan, cwd=blue, branch=magenta, arrow=green
  PS1="\[\e[33m\]\A\[\e[0m\] \[\e[36m\]\u\[\e[0m\] \[\e[34m\]\W\[\e[0m\]${gitbranch} \[\e[32m\]→\[\e[0m\] "
}
PROMPT_COMMAND=set_compact_prompt
